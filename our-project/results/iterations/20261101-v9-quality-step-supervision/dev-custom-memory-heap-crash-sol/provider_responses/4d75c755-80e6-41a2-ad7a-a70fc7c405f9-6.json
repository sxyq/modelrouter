        "arguments": "{\"command\":\"set -eu\\nulimit -c 0\\nworkdir=/tmp/app-crash-check.WDDZFS\\nprintf '\\\\n--- Valgrind preserving the custom allocator ---\\\\n'\\nfor mode in debug release; do\\n    valgrind --soname-synonyms=somalloc=libc.so.6 --leak-check=full --show-leak-kinds=all --errors-for-leak-kinds=all --error-exitcode=99 --log-file=\\\"$workdir/$mode.fixed-native-alloc.valgrind\\\" \\\"/app/$mode\\\" > \\\"$workdir/$mode.fixed-native-alloc.stdout\\\" 2> \\\"$workdir/$mode.fixed-native-alloc.stderr\\\"\\n    printf '\\\\n%s:\\\\n' \\\"$mode\\\"\\n    cat \\\"$workdir/$mode.fixed-native-alloc.valgrind\\\"\\n    diff -u \\\"$workdir/$mode.stdout\\\" \\\"$workdir/$mode.fixed-native-alloc.stdout\\\"\\ndone\\nprintf '\\\\n--- repeated runs and output edge cases ---\\\\n'\\nfor mode in debug release; do\\n    for iteration in $(seq 1 20); do\\n        \\\"/app/$mode\\\" > \\\"$workdir/$mode.repeat.stdout\\\" 2> \\\"$workdir/$mode.repeat.stderr\\\"\\n        cmp \\\"$workdir/$mode.stdout\\\" \\\"$workdir/$mode.repeat.stdout\\\"\\n        test ! -s \\\"$workdir/$mode.repeat.stderr\\\"\\n    done\\n    \\\"/app/$mode\\\" < /dev/null > /dev/null\\n    \\\"/app/$mode\\\" > /dev/full\\n    LC_ALL=C \\\"/app/$mode\\\" > \\\"$workdir/$mode.C-locale.stdout\\\"\\n    cmp \\\"$workdir/$mode.stdout\\\" \\\"$workdir/$mode.C-locale.stdout\\\"\\n    LC_ALL=C.utf8 \\\"/app/$mode\\\" > \\\"$workdir/$mode.utf8-locale.stdout\\\"\\n    cmp \\\"$workdir/$mode.stdout\\\" \\\"$workdir/$mode.utf8-locale.stdout\\\"\\n    printf '%s: 20 repeated runs, discarded output, failing output, and locale checks passed\\\\n' \\\"$mode\\\"\\ndone\\nprintf '\\\\n--- unchanged protected sources ---\\\\n'\\nsha256sum /app/main.cpp /app/user.h\"}",
