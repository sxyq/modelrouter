        "arguments": "{\"command\":\"cd /testbed && python - <<'PY'\\nfrom pathlib import Path\\n\\nsource = Path('pyasn1/codec/ber/decoder.py')\\ntext = source.read_text()\\nold = 'class ChoicePayloadDecoder():\\\\n'\\nnew = 'class ChoicePayloadDecoder(AbstractConstructedPayloadDecoder):\\\\n'\\nassert text.count(old) == 1\\nsource.write_text(text.replace(old, new))\\n\\ntests = Path('tests/codec/ber/test_decoder.py')\\ntext = tests.read_text()\\nanchor = '\\\\n\\\\nclass AnyDecoderTestCase(BaseTestCase):\\\\n'\\naddition = '''\\n    def testBySchemaWithTrailingData(self):\\n        taggedChoice = self.s.subtype(explicitTag=tag.Tag(\\n            tag.tagClassContext, tag.tagFormatConstructed, 4))\\n        schemas = (\\n            ('untagged', self.s),\\n            ('explicit', taggedChoice),\\n            ('explicit-indefinite', taggedChoice)\\n        )\\n        components = (\\n            ('place-holder', univ.Null(b''), bytes((5, 0))),\\n            ('number', univ.Integer(123), bytes((2, 1, 123))),\\n            ('string', univ.OctetString(b''), bytes((4, 0))),\\n            ('string', univ.OctetString(b'abc'), bytes((4, 3, 97, 98, 99)))\\n        )\\n        trailingData = bytes((5, 0))\\n        for encoding, schema in schemas:\\n            for name, value, substrate in components:\\n                with self.subTest(encoding=encoding, component=name,\\n                                  substrate=substrate):\\n                    if encoding == 'explicit':\\n                        substrate = bytes((164, len(substrate))) + substrate\\n                    elif encoding == 'explicit-indefinite':\\n                        substrate = bytes((164, 128)) + substrate + bytes((0, 0))\\n\\n                    result, rest = decoder.decode(\\n                        substrate + trailingData, asn1Spec=schema)\\n\\n                    self.assertIsInstance(result, univ.Choice)\\n                    self.assertEqual(result.getName(), name)\\n                    self.assertEqual(result.getComponent(), value)\\n                    self.assertEqual(result.tagSet, schema.tagSet)\\n                    self.assertEqual(rest, trailingData)\\n                    self.assertFalse(schema.isValue)\\n'''\\nassert text.count(anchor) == 1\\nassert 'def testBySchemaWithTrailingData' not in text\\ntests.write_text(text.replace(anchor, '\\\\n' + addition + anchor))\\nPY\\nPYTHONPATH=/testbed python /tmp/reproduce_choice_decoder.py && python -Werror -m unittest tests.codec.ber.test_decoder.ChoiceDecoderTestCase -v && git diff --check && git diff --stat && git diff -- pyasn1/codec/ber/decoder.py tests/codec/ber/test_decoder.py\"}",
