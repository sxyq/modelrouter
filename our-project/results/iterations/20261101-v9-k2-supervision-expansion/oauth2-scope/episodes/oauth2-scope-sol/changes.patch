+    def test_scope_order_and_duplicates(self):
+        expected = ['read', 'write', 'read', 'admin']
+        for scope in (expected, tuple(expected)):
+            with self.subTest(scope=scope):
+                self.assertEqual(list_to_scope(scope), 'read write read admin')
+                self.assertEqual(scope_to_list(scope), expected)
+                self.assertEqual(scope_to_list(list_to_scope(scope)), expected)
+
+    def test_scope_to_list_whitespace(self):
