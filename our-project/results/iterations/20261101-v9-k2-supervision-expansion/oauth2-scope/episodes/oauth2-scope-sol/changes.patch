+    def test_none_scope(self):
+        self.assertIsNone(list_to_scope(None))
+        self.assertIsNone(scope_to_list(None))
+
+    def test_list_to_scope_string_passthrough(self):
+        for scope in ('', 'read write admin', ' read  write admin '):
+            with self.subTest(scope=scope):
+                self.assertEqual(list_to_scope(scope), scope)
+
+    def test_empty_scope(self):
+        for scope in ([], (), set()):
+            with self.subTest(scope=scope):
+                self.assertEqual(list_to_scope(scope), '')
+                self.assertEqual(scope_to_list(scope), [])
+        self.assertEqual(scope_to_list(''), [])
+        self.assertEqual(scope_to_list(' \t\n '), [])
