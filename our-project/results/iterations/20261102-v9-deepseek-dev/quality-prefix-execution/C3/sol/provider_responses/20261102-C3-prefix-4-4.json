        "arguments": "{\"command\":\"cd /testbed && cat > /tmp/sqlparse_output_repro.py <<'PY'\\nimport sqlparse\\n\\ncases = [\\n    ('single', 'select * from foo;', {}),\\n    ('multiple', 'select * from foo; select 1 from dual', {}),\\n    ('reindented', 'select * from foo;', {'reindent': True}),\\n    ('three statements', 'select 1; select 2; select 3;', {}),\\n    ('quotes', '''select 'foo', \\\"bar\\\" from baz;''', {}),\\n    ('multiline', 'select *\\\\n  from foo;', {}),\\n    ('empty', '', {}),\\n]\\n\\nfor output_format in ('python', 'php'):\\n    for label, statement, options in cases:\\n        print(f'--- {output_format}: {label} ---')\\n        try:\\n            result = sqlparse.format(statement, output_format=output_format,\\n                                     **options)\\n            print(repr(result))\\n            print(result)\\n            if output_format == 'python':\\n                compile(result, '<formatted SQL>', 'exec')\\n        except Exception as exc:\\n            print(f'{type(exc).__name__}: {exc}')\\nPY\\nPYTHONPATH=/testbed python /tmp/sqlparse_output_repro.py\\npython -m pytest -q tests/test_format.py::TestOutputFormat\\n\"}",
