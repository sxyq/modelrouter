        "name": "bash",
        "arguments": "{\"command\": \"python3 - <<'PY'\\nimport requests,re,html\\nfrom urllib.parse import quote\\nq='Scandinavian MTEB leaderboard embedding'\\nfor base in ['https://html.duckduckgo.com/html/?q=','https://www.bing.com/search?q=']:\\n r=requests.get(base+quote(q),headers={'User-Agent':'Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 Chrome/120 Safari/537.36'},timeout=30)\\n print('\\\\n====',base,r.status_code)\\n txt=r.text\\n # links and snippets\\n for m in re.finditer(r'<a[^>]+href=\\\"([^\\\"]+)\\\"[^>]*>(.*?)</a>',txt,re.S|re.I):\\n  href=html.unescape(m.group(1)); label=re.sub('<.*?>','',m.group(2)); label=html.unescape(label).strip()\\n  if label and ('mteb' in (href+label).lower() or 'scandinav' in (href+label).lower() or 'nordic' in (href+label).lower()):\\n   print(label[:200],'->',href[:300])\\nPY\"}"
