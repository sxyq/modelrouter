        "name": "bash",
        "arguments": "{\"command\": \"cd /tmp && python3 - <<'PY'\\nimport json,gzip,struct,math\\nw=json.load(open('/app/weights.json'))\\nimg=gzip.open('t10k-images-idx3-ubyte.gz','rb').read()\\nlab=gzip.open('t10k-labels-idx1-ubyte.gz','rb').read()\\nmagic,n,rows,cols=struct.unpack('>IIII',img[:16]); print(magic,n,rows,cols)\\nlabels=list(lab[8:])\\ndef run(x):\\n def mv(x,W,b): return [sum(a*c for a,c in zip(x,r))+bb for r,bb in zip(W,b)]\\n def rl(x): return [v if v>0 else 0.0 for v in x]\\n h=rl(mv(x,w['input_layer.weight'],w['input_layer.bias']))\\n h=rl(mv(h,w['hidden_layer.weight'],w['hidden_layer.bias']))\\n return mv(h,w['output_layer.weight'],w['output_layer.bias'])\\nN=10000\\nvariants={\\n 'raw': lambda v: float(v),\\n 'div255': lambda v: v/255.0,\\n 'div255_norm': lambda v: (v/255.0-0.1307)/0.3081,\\n}\\nfor name,f in variants.items():\\n ok=0\\n for i in range(N):\\n  row=img[16+i*784:16+(i+1)*784]\\n  o=run([f(v) for v in row])\\n  p=max(range(10),key=lambda k:o[k])\\n  ok += p==labels[i]\\n print(name,ok,N,ok/N)\\nPY\"}"
      }
