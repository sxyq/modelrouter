        "status": "completed",
        "arguments": "{\"command\":\"cat <<'PY' > /tmp/test_filter.py\\nimport pathlib\\nimport subprocess\\nimport sys\\nimport tempfile\\nimport unittest\\n\\nSCRIPT = pathlib.Path('/app/filter.py')\\n\\nclass FilterTests(unittest.TestCase):\\n    def clean(self, source):\\n        with tempfile.TemporaryDirectory() as directory:\\n            path = pathlib.Path(directory) / 'document.html'\\n            path.write_bytes(source.encode('utf-8'))\\n            result = subprocess.run([sys.executable, str(SCRIPT), str(path)], capture_output=True, text=True)\\n            self.assertEqual(result.returncode, 0, result.stderr)\\n            return path.read_bytes().decode('utf-8')\\n\\n    def test_safe_document_unchanged(self):\\n        source = '''<!DOCTYPE html>\\\\n<html lang=\\\"en\\\"><head><title>Example</title>\\\\n<style>p { color: blue; }</style></head><body>\\\\n<!-- ordinary comment -->\\\\n<h1 id='heading' class=\\\"title\\\">Hello &amp; welcome</h1>\\\\n<table border=\\\"1\\\"><tr><th colspan=\\\"2\\\">Header</th></tr><tr><td>A</td><td>B</td></tr></table>\\\\n<p style=\\\"font-weight: bold\\\" data-description=\\\"javascript is a language\\\">Text</p>\\\\n<a href=\\\"https://example.org/?a=1&amp;b=2\\\" target=\\\"_blank\\\">Link</a>\\\\n<img src=\\\"data:image/png;base64,iVBORw0KGgo=\\\" alt=\\\"image\\\">\\\\n<svg viewBox=\\\"0 0 10 10\\\"><circle cx=\\\"5\\\" cy=\\\"5\\\" r=\\\"4\\\" fill=\\\"red\\\" /></svg>\\\\n<pre>literal javascript:alert(1) and onclick=example</pre>\\\\n</body></html>\\\\n'''\\n        self.assertEqual(self.clean(source), source)\\n\\n    def test_script_and_events(self):\\n        self.assertEqual(self.clean('<h1>Hello</h1><SCRIPT src=\\\"evil.js\\\">alert(1)</SCRIPT><p id=\\\"ok\\\" onclick=\\\"alert(2)\\\">World</p>'), '<h1>Hello</h1><p id=\\\"ok\\\">World</p>')\\n\\n    def test_all_event_attributes_and_duplicates(self):\\n        self.assertEqual(self.clean('<div ONLOAD=alert(1) onpointerenter=\\\"evil()\\\" onclick=x onclick=y title=\\\"safe\\\">ok</div>'), '<div title=\\\"safe\\\">ok</div>')\\n\\n    def test_encoded_urls(self):\\n        for value in ('javascript:alert(1)', 'JaVaScRiPt:alert(1)', '&#106;avascript&#58;alert(1)', 'java&#x09;script:alert(1)', '  javascript:alert(1)', 'vbscript:msgbox(1)', 'data:text/html,<script>alert(1)</script>'):\\n            with self.subTest(value=value):\\n                self.assertEqual(self.clean('<a href=\\\"' + value + '\\\" class=\\\"safe\\\">link</a>'), '<a class=\\\"safe\\\">link</a>')\\n\\n    def test_safe_urls_and_text(self):\\n        source = '<a href=\\\"/javascript:guide\\\" title=\\\"onclick=literal\\\">javascript: text</a><img src=\\\"images/javascript.png\\\"><textarea><script>literal</script></textarea>'\\n        self.assertEqual(self.clean(source), source)\\n\\n    def test_embedded_html(self):\\n        result = self.clean('<iframe title=\\\"safe\\\" srcdoc=\\\"&lt;p onclick=&quot;evil()&quot;&gt;Hello&lt;/p&gt;&lt;script&gt;evil()&lt;/script&gt;\\\"></iframe>')\\n        self.assertIn('Hello', result)\\n        self.assertNotIn('onclick', result)\\n        self.assertNotIn('script&gt;', result)\\n        self.assertIn('title=\\\"safe\\\"', result)\\n\\n    def test_css_script_vectors(self):\\n        result = self.clean('<p style=\\\"color: red; width: expression(alert(1)); background: url(javascript:alert(1)); font-weight: bold\\\">hello</p>')\\n        self.assertNotIn('expression', result.lower())\\n        self.assertNotIn('javascript', result.lower())\\n        self.assertIn('color: red', result)\\n        self.assertIn('font-weight: bold', result)\\n\\n    def test_unclosed_script(self):\\n        self.assertEqual(self.clean('<p>safe</p><script>alert(1)'), '<p>safe</p>')\\n\\n    def test_svg_script_and_links(self):\\n        self.assertEqual(self.clean('<svg><script>alert(1)</script><a xlink:href=\\\"javascript:evil()\\\"><text>ok</text></a></svg>'), '<svg><a><text>ok</text></a></svg>')\\n\\n    def test_idempotent(self):\\n        source = '<p onclick=\\\"evil()\\\">safe</p><script>evil()</script>'\\n        once = self.clean(source)\\n        self.assertEqual(self.clean(once), once)\\n\\nif __name__ == '__main__':\\n    unittest.main(verbosity=2)\\nPY\\npython /tmp/test_filter.py 2>&1 | tail -22\\npython - <<'PY'\\nimport importlib.util\\nfor name in ('tinycss2', 'cssselect2', 'pip._vendor.html5lib', 'soupsieve'):\\n    try:\\n        found = importlib.util.find_spec(name)\\n    except (ImportError, ModuleNotFoundError):\\n        found = None\\n    print(name, found.origin if found else 'not installed')\\nPY\"}",
