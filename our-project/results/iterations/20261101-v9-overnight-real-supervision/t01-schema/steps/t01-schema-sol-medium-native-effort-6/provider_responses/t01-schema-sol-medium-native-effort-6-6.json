        "arguments": "{\"command\":\"cd /testbed && python - <<'PY'\\nfrom pathlib import Path\\n\\npath = Path('schema/__init__.py')\\ntext = path.read_text()\\nold = '''def _invoke_with_optional_kwargs(f: Callable[..., Any], **kwargs: Any) -> Any:\\n    return f(**kwargs)\\n    s = inspect.signature(f)\\n    if len(s.parameters) == 0:\\n        return f()\\n\\nclass Schema(object):\\n'''\\nnew = '''def _invoke_with_optional_kwargs(f: Callable[..., Any], **kwargs: Any) -> Any:\\n    \\\"\\\"\\\"Pass kwargs to a callable unless it has a parameterless signature.\\\"\\\"\\\"\\n    if not kwargs:\\n        return f()\\n    try:\\n        s = inspect.signature(f)\\n    except (TypeError, ValueError):\\n        # Some built-in callables do not expose a signature.\\n        return f(**kwargs)\\n    if len(s.parameters) == 0:\\n        return f()\\n    return f(**kwargs)\\n\\n\\nclass Schema(object):\\n'''\\nassert text.count(old) == 1\\npath.write_text(text.replace(old, new))\\n\\npath = Path('test_schema.py')\\ntext = path.read_text().replace('''\\n\\n\\n@mark.parametrize(\\\"default\\\", [dict, list, set, int, str])''', '''\\n\\n@mark.parametrize(\\\"default\\\", [dict, list, set, int, str])''')\\npath.write_text(text)\\nPY\\nPYTHONPATH=/testbed python /tmp/schema_optional_defaults_repro.py && python -m pytest -q --doctest-glob=README.rst && git diff --check && git diff --stat\"}",
