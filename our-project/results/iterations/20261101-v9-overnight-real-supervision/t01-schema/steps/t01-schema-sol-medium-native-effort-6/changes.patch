+def test_optional_callable_objects_ignore_validate_kwargs():
+    class Default:
+        def __call__(self):
+            return 42
+
+    default_object = Default()
+    for default in (
+        default_object,
+        default_object.__call__,
+        partial(lambda value: value, 42),
+    ):
+        s = Schema({Optional("k", default=default): int})
+        assert s.validate({}, increment=1) == {"k": 42}
+
+
+def test_optional_callable_default_receives_named_kwargs():
+    def default(*, increment):
+        return 42 + increment
+
+    s = Schema({Optional("k", default=default): int})
+    assert s.validate({}, increment=1) == {"k": 43}
+
+
