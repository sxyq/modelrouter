        "arguments": "{\"command\":\"cd /testbed && python - <<'PY'\\nfrom pathlib import Path\\n\\npath = Path('test_schema.py')\\ntext = path.read_text()\\nanchor = '\\\\ndef test_inheritance_optional():\\\\n'\\nnew_tests = '''\\n@mark.parametrize(\\\"default\\\", [dict, list, set, int, str])\\ndef test_optional_builtin_callable_defaults(default):\\n    s = Schema({Optional(\\\"k\\\", default=default): object})\\n    assert s.validate({}) == {\\\"k\\\": default()}\\n\\n\\ndef test_optional_builtin_callable_default_receives_kwargs():\\n    s = Schema({Optional(\\\"k\\\", default=dict): dict})\\n    assert s.validate({}, increment=1) == {\\\"k\\\": {\\\"increment\\\": 1}}\\n\\n\\ndef test_optional_callable_objects_ignore_validate_kwargs():\\n    class Default:\\n        def __call__(self):\\n            return 42\\n\\n    default_object = Default()\\n    for default in (\\n        default_object,\\n        default_object.__call__,\\n        partial(lambda value: value, 42),\\n    ):\\n        s = Schema({Optional(\\\"k\\\", default=default): int})\\n        assert s.validate({}, increment=1) == {\\\"k\\\": 42}\\n\\n\\ndef test_optional_callable_default_receives_named_kwargs():\\n    def default(*, increment):\\n        return 42 + increment\\n\\n    s = Schema({Optional(\\\"k\\\", default=default): int})\\n    assert s.validate({}, increment=1) == {\\\"k\\\": 43}\\n\\n\\ndef test_optional_callable_default_type_error_is_not_retried():\\n    calls = []\\n\\n    def default(**kwargs):\\n        calls.append(kwargs)\\n        raise TypeError(\\\"default failed\\\")\\n\\n    s = Schema({Optional(\\\"k\\\", default=default): int})\\n    with raises(TypeError, match=\\\"default failed\\\"):\\n        s.validate({}, increment=1)\\n    assert calls == [{\\\"increment\\\": 1}]\\n\\n'''\\nassert text.count(anchor) == 1\\ntext = text.replace(anchor, '\\\\n' + new_tests + anchor)\\nold = 'def test_json_schema_default_is_callable():\\\\n'\\nnew = '@mark.parametrize(\\\"kwargs\\\"