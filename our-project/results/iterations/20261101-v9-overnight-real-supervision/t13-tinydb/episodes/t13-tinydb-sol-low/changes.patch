+@pytest.mark.parametrize('left_result', [False, True])
+@pytest.mark.parametrize('right_result', [False, True])
+def test_and_short_circuit(left_result, right_result):
+    calls = []
+
+    def left_test(value):
+        calls.append('left')
+        return value['left']
+
+    def right_test(value):
+        calls.append('right')
+        return value['right']
+
+    left = QueryInstance(left_test, ('left',))
+    right = QueryInstance(right_test, ('right',))
+    query = left & right
+
+    assert isinstance(query, QueryInstance)
+    assert query({'left': left_result, 'right': right_result}) is (
+        left_result and right_result
+    )
+    assert calls == (['left', 'right'] if left_result else ['left'])
+
+
+@pytest.mark.parametrize('left_cacheable', [False, True])
+@pytest.mark.parametrize('right_cacheable', [False, True])
+def test_and_cacheable(left_cacheable, right_cacheable):
+    left = QueryInstance(
+        lambda value: True, ('left',) if left_cacheable else None
+    )
+    right = QueryInstance(
+        lambda value: True, ('right',) if right_cacheable else None
+    )
+    query = left & right
+
+    assert query({})
+    assert query.is_cacheable() is (left_cacheable and right_cacheable)
+    if query.is_cacheable():
+        assert query == (right & left)
+        assert hash(query) == hash(right & left)
+        assert query != (left | right)
+
+
 def test_not():
     query = ~ (Query().val1 == 1)
     assert query({'val1': 5, 'val2': 2})
