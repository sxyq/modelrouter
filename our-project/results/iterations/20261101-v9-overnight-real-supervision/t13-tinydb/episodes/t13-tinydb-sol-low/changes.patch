+@pytest.mark.parametrize('reverse', [False, True])
+def test_query_cache_with_mutable_callable_and(db, reverse):
+    table = db.table('table')
+    table.insert({'val': 5})
+
+    mutable = 5
+
+    def increase(value):
+        return value + mutable
+
+    cacheable = where('val').exists()
+    non_cacheable = where('val').map(increase) == 10
+    query = (non_cacheable & cacheable) if reverse else (
+        cacheable & non_cacheable
+    )
+
+    assert not query.is_cacheable()
+    assert table.count(query) == 1
+
+    mutable = 10
+
+    assert table.count(query) == 0
+    assert not table._query_cache
+
+
 def test_zero_cache_size(db):
