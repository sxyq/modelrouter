+class TestAddColumn:
+    @pytest.mark.parametrize(
+        "column", [[], ["Value 1"], ["Value 1", "Value 2", "Value 3"]]
+    )
+    def test_add_column_to_empty_table(self, column: list[str]) -> None:
+        table = PrettyTable()
+
+        table.add_column("Column 1", column)
+
+        assert table.field_names == ["Column 1"]
+        assert table.rows == [[value] for value in column]
+        assert table.dividers == [False] * len(column)
+        assert table.align["Column 1"] == "c"
+        assert table.valign["Column 1"] == "t"
+
+    def test_add_column_to_existing_rows(self) -> None:
+        table = PrettyTable(["Column 1"])
+        table.add_row(["Value 1"], divider=True)
+        table.add_row(["Value 2"])
+
+        table.add_column("Column 2", (1, 2), align="l", valign="b")
+
+        assert table.field_names == ["Column 1", "Column 2"]
+        assert table.rows == [["Value 1", 1], ["Value 2", 2]]
+        assert table.dividers == [True, False]
+        assert table.align["Column 2"] == "l"
+        assert table.valign["Column 2"] == "b"
+
+    @pytest.mark.parametrize("column", [[], [1], [1, 2, 3]])
+    def test_add_column_with_incorrect_length(self, column: list[int]) -> None:
+        table = PrettyTable(["Column 1"])
+        table.add_rows([["Value 1"], ["Value 2"]])
+
+        with pytest.raises(
+            ValueError,
+            match=f"Column length {len(column)} does not match number of rows 2",
+        ):
+            table.add_column("Column 2", column)
+
+        assert table.field_names == ["Column 1"]
+        assert table.rows == [["Value 1"], ["Value 2"]]
+        assert table.dividers == [False, False]
+        assert "Column 2" not in table.align
+        assert "Column 2" not in table.valign
+
+
