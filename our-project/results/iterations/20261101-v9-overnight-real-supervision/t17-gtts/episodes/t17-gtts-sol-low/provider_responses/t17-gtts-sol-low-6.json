        "arguments": "{\"command\":\"cd /testbed && git diff --check && git diff --stat && git diff -- gtts/tts.py gtts/tests/test_tts.py && PYTHONPATH=/testbed python - <<'PY'\\nfrom pathlib import Path\\nfrom tempfile import TemporaryDirectory\\nfrom unittest.mock import Mock, patch\\n\\nimport requests\\nfrom gtts import gTTS, gTTSError\\n\\nassert issubclass(gTTSError, Exception)\\nfor msg in (None, \\\"\\\", \\\"Custom error message\\\", \\\"Erreur : échec 日本語\\\"):\\n    error = gTTSError(msg)\\n    try:\\n        raise error\\n    except Exception as caught:\\n        assert caught is error\\n        assert error.args == (error.msg,)\\n        assert str(error) == str(error.msg)\\nprint(\\\"PASS: default, empty, explicit, and Unicode error messages\\\")\\n\\nwith TemporaryDirectory() as directory:\\n    tts = gTTS(\\\"Hello\\\", lang_check=False)\\n    with patch(\\\"gtts.tts.requests.Session.send\\\", side_effect=requests.exceptions.Timeout(\\\"offline\\\")):\\n        try:\\n            tts.save(Path(directory) / \\\"test.mp3\\\")\\n        except gTTSError as error:\\n            assert error.tts is tts\\n            assert str(error) == \\\"Failed to connect. Probable cause: Unknown\\\"\\n        else:\\n            raise AssertionError(\\\"save() did not raise gTTSError\\\")\\nprint(\\\"PASS: save() propagates gTTSError on a request timeout\\\")\\n\\nresponse = Mock(status_code=200, reason=\\\"OK\\\")\\nresponse.iter_lines.return_value = [b'[\\\"jQ1olc\\\",null]']\\ntts = gTTS(\\\"Hello\\\", lang=\\\"xyz\\\", lang_check=False)\\nwith patch(\\\"gtts.tts.requests.Session.send\\\", return_value=response):\\n    try:\\n        list(tts.stream())\\n    except gTTSError as error:\\n        assert error.rsp is response\\n        assert \\\"Unsupported language 'xyz'\\\" in str(error)\\n    else:\\n        raise AssertionError(\\\"stream() did not raise gTTSError\\\")\\nprint(\\\"PASS: stream() propagates an inferred unsupported-language error\\\")\\nPY\"}",
