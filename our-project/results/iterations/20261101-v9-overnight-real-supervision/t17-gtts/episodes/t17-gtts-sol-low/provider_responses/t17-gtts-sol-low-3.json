        "arguments": "{\"command\":\"cd /testbed && sed -n '1,125p' gtts/lang.py && cat > /tmp/gtts_error_repro.py <<'PY'\\nfrom io import BytesIO\\nfrom unittest.mock import patch\\n\\nimport requests\\n\\nfrom gtts import gTTS, gTTSError\\n\\n\\ndef custom_error():\\n    error = gTTSError(\\\"Custom error message\\\")\\n    try:\\n        raise error\\n    except gTTSError as caught:\\n        assert caught is error\\n        assert str(caught) == \\\"Custom error message\\\"\\n        assert caught.args == (\\\"Custom error message\\\",)\\n        print(f\\\"Caught custom gTTSError: {caught}\\\")\\n\\n\\ndef request_error():\\n    tts = gTTS(\\\"Hello\\\", lang_check=False)\\n    with patch(\\\"gtts.tts.requests.Session.send\\\", side_effect=requests.exceptions.ConnectionError(\\\"offline\\\")):\\n        try:\\n            tts.write_to_fp(BytesIO())\\n        except gTTSError as caught:\\n            assert caught.tts is tts\\n            assert str(caught) == \\\"Failed to connect. Probable cause: Unknown\\\"\\n            print(f\\\"Caught request gTTSError: {caught}\\\")\\n\\n\\ndef invalid_language():\\n    try:\\n        gTTS(\\\"Hello\\\", lang=\\\"xyz\\\")\\n    except ValueError as caught:\\n        assert str(caught) == \\\"Language not supported: xyz\\\"\\n        print(f\\\"Caught expected validation ValueError: {caught}\\\")\\n    else:\\n        raise AssertionError(\\\"Invalid language was not rejected\\\")\\n\\n\\nfailures = 0\\nfor check in (custom_error, request_error, invalid_language):\\n    try:\\n        check()\\n    except Exception as error:\\n        failures += 1\\n        print(f\\\"FAIL {check.__name__}: {type(error).__name__}: {error}\\\")\\n\\nraise SystemExit(bool(failures))\\nPY\\nPYTHONPATH=/testbed python /tmp/gtts_error_repro.py\\npython -m pytest -q gtts/tests/test_tts.py -k 'test_msg or test_infer_msg'\"}",
