      {
        "id": "fc_01ee66befe1b0d5f016ae65a7d0c888196b46ae670c3bbb470",
        "type": "function_call",
        "status": "completed",
        "arguments": "{\"command\":\"cd /testbed && python - <<'PY'\\nfrom pathlib import Path\\n\\npath = Path('gtts/tests/test_tts.py')\\nsource = path.read_text()\\nsource = source.replace('import os\\\\nimport pytest\\\\n', 'import os\\\\nfrom io import BytesIO\\\\n\\\\nimport pytest\\\\nimport requests\\\\n', 1)\\nanchor = '\\\\ndef test_infer_msg():\\\\n'\\nassert source.count(anchor) == 1\\nsource = source.replace(anchor, '''\\n@pytest.mark.parametrize(\\\"exception_type\\\", [gTTSError, Exception])\\n@pytest.mark.parametrize(\\\"msg\\\", [None, \\\"Custom error message\\\"])\\ndef test_exception(msg, exception_type):\\n    \\\"\\\"\\\"gTTSError can be raised and caught as a standard exception.\\\"\\\"\\\"\\n    error = gTTSError(msg)\\n    with pytest.raises(exception_type) as caught:\\n        raise error\\n\\n    assert caught.value is error\\n    assert error.args == (msg,)\\n    assert str(error) == str(msg)\\n\\n\\ndef test_exception_class():\\n    \\\"\\\"\\\"gTTSError can also be raised without constructing it explicitly.\\\"\\\"\\\"\\n    with pytest.raises(gTTSError):\\n        raise gTTSError\\n\\n\\ndef test_exception_custom_message_with_context():\\n    \\\"\\\"\\\"An explicit message takes precedence without losing error context.\\\"\\\"\\\"\\n    tts = Mock(tld=\\\"invalid\\\")\\n    response = Mock(status_code=500, reason=\\\"Server Error\\\")\\n    error = gTTSError(\\\"Custom error message\\\", tts=tts, response=response)\\n\\n    assert error.tts is tts\\n    assert error.rsp is response\\n    assert error.msg == \\\"Custom error message\\\"\\n    assert error.args == (error.msg,)\\n    assert str(error) == error.msg\\n\\n\\n@pytest.mark.parametrize(\\\"failure\\\", [\\\"connection\\\", \\\"timeout\\\", \\\"http\\\", \\\"no_audio\\\"])\\ndef test_request_error(failure, monkeypatch):\\n    \\\"\\\"\\\"API failures propagate as gTTSError rather than a file-object TypeError.\\\"\\\"\\\"\\n    tts = gTTS(\\\"Hello\\\", lang=\\\"xyz\\\", lang_check=False)\\n    response = Mock(status_code=200, reason=\\\"OK\\\")\\n    send = Mock(return_value=response)\\n    expected_response = response\\n\\n    if failure in (\\\"connection\\\", \\\"timeout\\\"):\\n        exception = (\\n            requests.exceptions.ConnectionError\\n            if failure == \\\"connection\\\"\\n            else requests.exceptions.Timeout\\n        )\\n        send.side_effect = exception(\\\"offline\\\")\\n        expected_response = None\\n        expected_message = \\\"Failed to connect. Probable cause: Unknown\\\"\\n    elif failure == \\\"http\\\":\\n        response.status_code = 403\\n        response.reason = \\\"Forbidden\\\"\\n        response.raise_for_status.side_effect = requests.exceptions.HTTPError()\\n        expected_message = (\\n            \\\"403 (Forbidden) from TTS API. Probable cause: \\\"\\n            \\\"Bad token or upstream API changes\\\"\\n        )\\n    else:\\n        response.iter_lines.return_value = [b'[\\\"jQ1olc\\\",null]']\\n        expected_message = (\\n            \\\"200 (OK) from TTS API. Probable cause: \\\"\\n            \\\"No audio stream in response. Unsupported language 'xyz'\\\"\\n        )\\n\\n    monkeypatch.setattr(\\\"gtts.tts.requests.Session.send\\\", send)\\n    with pytest.raises(gTTSError) as caught:\\n        tts.write_to_fp(BytesIO())\\n\\n    error = caught.value\\n    assert error.tts is tts\\n    assert error.rsp is expected_response\\n    assert error.msg == expected_message\\n    assert error.args == (expected_message,)\\n    assert str(error) == expected_message\\n\\n''' + anchor, 1)\\npath.write_text(source)\\nPY\\npython -m pytest -q gtts/tests/test_tts.py -k 'test_exception or test_request_error'\"}",
