        "arguments": "{\"command\":\"cd /testbed && python - <<'PY'\\nfrom pathlib import Path\\n\\npath = Path('tests/test_timeout.py')\\nsource = path.read_text()\\nsource = source.replace(\\n    'from typing import Any, Callable, List, TypeVar\\\\n',\\n    'from typing import Any, Callable, List, Optional, TypeVar\\\\n',\\n)\\nmarker = '\\\\n\\\\n@pytest.mark.asyncio\\\\nasync def test_enter_twice() -> None:\\\\n'\\nnew_tests = '''\\n\\n@pytest.mark.parametrize(\\\"method\\\", [\\\"shift\\\", \\\"update\\\"])\\n@pytest.mark.asyncio\\nasync def test_reschedule_after_timeout(method: str) -> None:\\n    with pytest.raises(asyncio.TimeoutError):\\n        async with timeout(0) as cm:\\n            await asyncio.sleep(10)\\n\\n    assert cm.expired\\n    deadline = cm.deadline\\n    with pytest.raises(\\n        RuntimeError,\\n        match=(\\n            \\\"(cannot reschedule expired timeout)|\\\"\\n            \\\"(Cannot change state of expired Timeout)\\\"\\n        ),\\n    ):\\n        if method == \\\"shift\\\":\\n            cm.shift(1)\\n        else:\\n            cm.update(asyncio.get_running_loop().time() + 1)\\n    assert cm.deadline == deadline\\n    assert cm.expired\\n\\n\\n@pytest.mark.parametrize(\\\"delay\\\", [None, 1])\\n@pytest.mark.asyncio\\nasync def test_update_after_cm_exit(delay: Optional[float]) -> None:\\n    async with timeout(delay) as cm:\\n        await asyncio.sleep(0)\\n\\n    deadline = cm.deadline\\n    with pytest.raises(\\n        RuntimeError,\\n        match=(\\n            \\\"(cannot reschedule after exit from context manager)|\\\"\\n            \\\"(Cannot change state of finished Timeout)\\\"\\n        ),\\n    ):\\n        cm.update(asyncio.get_running_loop().time() + 1)\\n    assert cm.deadline == deadline\\n    assert not cm.expired\\n'''\\nassert source.count(marker) == 1\\npath.write_text(source.replace(marker, new_tests + marker))\\nPY\\npython -m pytest -q -o addopts='' -k 'reschedule_after_timeout or update_after_cm_exit' --tb=short\"}",
