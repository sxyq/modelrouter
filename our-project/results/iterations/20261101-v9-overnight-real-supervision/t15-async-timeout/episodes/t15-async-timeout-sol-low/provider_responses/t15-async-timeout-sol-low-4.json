        "arguments": "{\"command\":\"cd /testbed && cat <<'PY' > /tmp/reproduce_timeout_rescheduling.py\\nimport asyncio\\n\\nfrom async_timeout import timeout\\n\\n\\nasync def main():\\n    loop = asyncio.get_running_loop()\\n    for expired in (False, True):\\n        try:\\n            async with timeout(0 if expired else 60) as t:\\n                await asyncio.sleep(0.01 if expired else 0)\\n        except asyncio.TimeoutError:\\n            print(\\\"Timeout occurred\\\")\\n        original_deadline = t.deadline\\n        for method, value in ((\\\"shift\\\", 1.0), (\\\"update\\\", loop.time() + 1.0)):\\n            try:\\n                getattr(t, method)(value)\\n            except RuntimeError as exc:\\n                print(f\\\"{method} after {'expiration' if expired else 'exit'}: {exc}\\\")\\n            else:\\n                raise AssertionError(f\\\"{method} unexpectedly succeeded\\\")\\n            assert t.deadline == original_deadline\\n\\n\\nasyncio.run(main())\\nPY\\nprintf '\\\\n--- reproduction: Python 3.10 ---\\\\n' && PYTHONPATH=/testbed python /tmp/reproduce_timeout_rescheduling.py && printf '\\\\n--- reproduction: Python 3.12 ---\\\\n' && PYTHONPATH=/testbed python3.12 /tmp/reproduce_timeout_rescheduling.py && printf '\\\\n--- existing functional tests ---\\\\n' && sed -n '85,265p' tests/test_timeout.py && printf '\\\\n--- baseline suite ---\\\\n' && python -m pytest -q\"}",
