        "arguments": "{\"command\":\"cd /testbed && cat <<'EOF' > /tmp/verify_choice_decoder_edges.py\\nfrom pyasn1.codec.ber import decoder as ber_decoder, encoder as ber_encoder\\nfrom pyasn1.codec.cer import decoder as cer_decoder, encoder as cer_encoder\\nfrom pyasn1.codec.der import decoder as der_decoder, encoder as der_encoder\\nfrom pyasn1.error import PyAsn1Error\\nfrom pyasn1.type import namedtype, tag, univ\\n\\n\\ndef make_choice():\\n    return univ.Choice(componentType=namedtype.NamedTypes(\\n        namedtype.NamedType('null', univ.Null()),\\n        namedtype.NamedType('boolean', univ.Boolean()),\\n        namedtype.NamedType('octetString', univ.OctetString()),\\n    ))\\n\\n\\nbase = make_choice()\\nexplicit = base.subtype(explicitTag=tag.Tag(\\n    tag.tagClassContext, tag.tagFormatConstructed, 4))\\ndouble_explicit = explicit.subtype(explicitTag=tag.Tag(\\n    tag.tagClassContext, tag.tagFormatConstructed, 33))\\nschemas = (base, explicit, double_explicit)\\ncomponents = (\\n    ('null', univ.Null(b'')),\\n    ('boolean', univ.Boolean(False)),\\n    ('boolean', univ.Boolean(True)),\\n    ('octetString', univ.OctetString(b'fox')),\\n    ('octetString', univ.OctetString(b'x' * 1001)),\\n)\\ncodecs = (\\n    ('BER definite', ber_encoder, ber_decoder, {'defMode': True}),\\n    ('BER indefinite/chunked', ber_encoder, ber_decoder,\\n     {'defMode': False, 'maxChunkSize': 2}),\\n    ('CER', cer_encoder, cer_decoder, {}),\\n    ('DER', der_encoder, der_decoder, {}),\\n)\\n\\n\\ndef verify_round_trip(encoder, decoder, options, schema, expected):\\n    encoded = encoder.encode(expected, **options)\\n    result, rest = decoder.decode(encoded + b'\\\\x05\\\\x00', asn1Spec=schema)\\n    assert result == expected\\n    assert result.isSameTypeWith(expected)\\n    assert result.tagSet == schema.tagSet\\n    if isinstance(expected, univ.Choice):\\n        assert result.getName() == expected.getName()\\n        assert result.getComponent().isSameTypeWith(expected.getComponent())\\n    assert rest == b'\\\\x05\\\\x00'\\n    assert not schema.isValue\\n    streamed = list(decoder.StreamingDecoder(encoded + encoded, asn1Spec=schema))\\n    assert len(streamed) == 2\\n    assert all(item == expected for item in streamed)\\n    return result\\n\\n\\ntotal = 0\\nfor label, encoder, decoder, options in codecs:\\n    count = 0\\n    for schema in schemas:\\n        for name, component in components:\\n            expected = schema.clone().setComponentByName(name, component)\\n            verify_round_trip(encoder, decoder, options, schema, expected)\\n            count += 1\\n\\n        for outer_tag in (None, tag.Tag(\\n                tag.tagClassContext, tag.tagFormatConstructed, 7)):\\n            outer = univ.Choice(componentType=namedtype.NamedTypes(\\n                namedtype.NamedType('nested', schema),\\n                namedtype.NamedType('integer', univ.Integer()),\\n            ))\\n            if outer_tag is not None:\\n                outer = outer.subtype(explicitTag=outer_tag)\\n            inner = schema.clone().setComponentByName('boolean', univ.Boolean(True))\\n            expected = outer.clone().setComponentByName('nested', inner)\\n            result = verify_round_trip(encoder, decoder, options, outer, expected)\\n            assert result['nested'].getName() == 'boolean'\\n            count += 1\\n\\n        sequence = univ.Sequence(componentType=namedtype.NamedTypes(\\n            namedtype.NamedType('choice', schema),\\n            namedtype.NamedType('integer', univ.Integer()),\\n        ))\\n        expected = sequence.clone()\\n        expected['choice'] = schema.clone().setComponentByName(\\n            'octetString', univ.OctetString(b'fox'))\\n        expected['integer'] = 42\\n        verify_round_trip(encoder, decoder, options, sequence, expected)\\n        count += 1\\n\\n    for schema, encoded in (\\n            (base, bytes((2, 1, 1))),\\n            (explicit, bytes((164, 2, 5))),\\n            (explicit, bytes((164, 128, 5, 0)))):\\n        try:\\n            decoder.decode(encoded, asn1Spec=schema)\\n        except PyAsn1Error:\\n            pass\\n        else:\\n            raise AssertionError('malformed CHOICE accepted: %r' % encoded)\\n        count += 1\\n\\n    print('%s: %d edge cases passed' % (label, count))\\n    total += count\\nprint('Total: %d edge cases passed' % total)\\nEOF\\nPYTHONPATH=/testbed python -Werror /tmp/verify_choice_decoder_edges.py && git diff --check && git diff && git status --short\"}",
