        "id": "fc_058c8d78817ac366016ae65c12ade08190843acc789fa263e8",
        "type": "function_call",
        "status": "completed",
        "arguments": "{\"command\":\"cd /testbed && printf '\\\\n--- Test settings ---\\\\n' && sed -n '40,150p' pyproject.toml && printf '\\\\n--- TTS unit tests ---\\\\n' && sed -n '1,175p' gtts/tests/test_tts.py && printf '\\\\n--- Reproduction script ---\\\\n' && cat > /tmp/reproduce_gtts_language_fallback.py <<'PY'\\nimport warnings\\n\\nfrom gtts import gTTS\\n\\nfor lang, expected in [\\n    (\\\"zh-cn\\\", \\\"zh-CN\\\"),\\n    (\\\"zh-tw\\\", \\\"zh-TW\\\"),\\n    (\\\"es-es\\\", \\\"es\\\"),\\n    (\\\"es-us\\\", \\\"es\\\"),\\n    (\\\"en-gb\\\", \\\"en\\\"),\\n]:\\n    with warnings.catch_warnings(record=True) as caught:\\n        warnings.simplefilter(\\\"always\\\", DeprecationWarning)\\n        tts = gTTS(text=\\\"Hello world\\\", lang=lang)\\n    assert tts.lang == expected, (lang, tts.lang)\\n    assert len(caught) == 1, (lang, caught)\\n    assert caught[0].category is DeprecationWarning\\n    assert \\\"falling back to '{}'\\\".format(expected) in str(caught[0].message)\\n    print(\\\"{} -> {} (with deprecation warning)\\\".format(lang, tts.lang))\\n\\nwith warnings.catch_warnings(record=True) as caught:\\n    warnings.simplefilter(\\\"always\\\")\\n    tts = gTTS(text=\\\"Hello world\\\", lang=\\\"en\\\")\\nassert tts.lang == \\\"en\\\"\\nassert not caught\\nprint(\\\"en -> en (without warning)\\\")\\nPY\\nPYTHONPATH=/testbed python /tmp/reproduce_gtts_language_fallback.py\"}",
