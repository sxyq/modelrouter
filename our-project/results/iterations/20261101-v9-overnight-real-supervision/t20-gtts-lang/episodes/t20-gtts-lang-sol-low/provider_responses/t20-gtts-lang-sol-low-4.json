        "arguments": "{\"command\":\"cd /testbed && python - <<'PY'\\nfrom pathlib import Path\\n\\npath = Path(\\\"gtts/tests/test_lang.py\\\")\\nsource = path.read_text()\\nsource = source.replace(\\\"import pytest\\\\n\\\", \\\"import warnings\\\\nimport pytest\\\\n\\\", 1)\\nold = '''def test_deprecated_lang():\\n    \\\"\\\"\\\"Test language deprecation fallback\\\"\\\"\\\"\\n    with pytest.deprecated_call():\\n        assert _fallback_deprecated_lang(\\\"en-gb\\\") == \\\"en\\\"\\n'''\\nnew = '''@pytest.mark.parametrize(\\n    \\\"lang, fallback_lang\\\",\\n    [\\n        (\\\"en-us\\\", \\\"en\\\"),\\n        (\\\"en-ca\\\", \\\"en\\\"),\\n        (\\\"en-uk\\\", \\\"en\\\"),\\n        (\\\"en-gb\\\", \\\"en\\\"),\\n        (\\\"en-au\\\", \\\"en\\\"),\\n        (\\\"en-gh\\\", \\\"en\\\"),\\n        (\\\"en-in\\\", \\\"en\\\"),\\n        (\\\"en-ie\\\", \\\"en\\\"),\\n        (\\\"en-nz\\\", \\\"en\\\"),\\n        (\\\"en-ng\\\", \\\"en\\\"),\\n        (\\\"en-ph\\\", \\\"en\\\"),\\n        (\\\"en-za\\\", \\\"en\\\"),\\n        (\\\"en-tz\\\", \\\"en\\\"),\\n        (\\\"fr-fr\\\", \\\"fr\\\"),\\n        (\\\"pt-br\\\", \\\"pt\\\"),\\n        (\\\"pt-pt\\\", \\\"pt\\\"),\\n        (\\\"es-es\\\", \\\"es\\\"),\\n        (\\\"es-us\\\", \\\"es\\\"),\\n        (\\\"zh-cn\\\", \\\"zh-CN\\\"),\\n        (\\\"zh-tw\\\", \\\"zh-TW\\\"),\\n    ],\\n)\\n@pytest.mark.parametrize(\\n    \\\"case\\\", [str.lower, str.upper, str.title], ids=[\\\"lowercase\\\", \\\"uppercase\\\", \\\"mixed-case\\\"]\\n)\\ndef test_deprecated_lang(lang, fallback_lang, case):\\n    \\\"\\\"\\\"Test language deprecation fallback regardless of case\\\"\\\"\\\"\\n    with pytest.deprecated_call(match=\\\"falling back to '{}'\\\".format(fallback_lang)):\\n        assert _fallback_deprecated_lang(case(lang)) == fallback_lang\\n\\n\\n@pytest.mark.parametrize(\\\"lang\\\", [\\\"en\\\", \\\"fr\\\", \\\"pt\\\", \\\"es\\\", \\\"zh\\\", \\\"xx\\\", \\\"EN\\\", \\\"\\\"])\\ndef test_non_deprecated_lang(lang):\\n    \\\"\\\"\\\"Non-deprecated language tags are returned as-is without warnings\\\"\\\"\\\"\\n    with warnings.catch_warnings(record=True) as caught:\\n        warnings.simplefilter(\\\"always\\\")\\n        assert _fallback_deprecated_lang(lang) == lang\\n    assert not caught\\n'''\\nassert old in source\\npath.write_text(source.replace(old, new, 1))\\n\\npath = Path(\\\"gtts/tests/test_tts.py\\\")\\nsource = path.read_text()\\nsource = source.replace(\\\"import os\\\\n\\\", \\\"import os\\\\nimport warnings\\\\n\\\", 1)\\nanchor = '\\\\ndef test_empty_string():\\\\n'\\nnew = '''\\n@pytest.mark.parametrize(\\n    \\\"lang, fallback_lang\\\",\\n    [\\n        (\\\"en-gb\\\", \\\"en\\\"),\\n        (\\\"fr-fr\\\", \\\"fr\\\"),\\n        (\\\"pt-br\\\", \\\"pt\\\"),\\n        (\\\"es-es\\\", \\\"es\\\"),\\n        (\\\"es-us\\\", \\\"es\\\"),\\n        (\\\"zh-cn\\\", \\\"zh-CN\\\"),\\n        (\\\"zh-tw\\\", \\\"zh-TW\\\"),\\n    ],\\n)\\ndef test_deprecated_language_check(lang, fallback_lang):\\n    \\\"\\\"\\\"Deprecated language codes fall back during gTTS initialization\\\"\\\"\\\"\\n    with pytest.deprecated_call(match=\\\"falling back to '{}'\\\".format(fallback_lang)):\\n        tts = gTTS(text=\\\"Hello world\\\", lang=lang)\\n    assert tts.lang == fallback_lang\\n\\n\\n@pytest.mark.parametrize(\\\"lang\\\", [\\\"en-gb\\\", \\\"es-es\\\", \\\"zh-cn\\\", \\\"zh-tw\\\", \\\"xx\\\"])\\ndef test_language_check_disabled(lang):\\n    \\\"\\\"\\\"Disabling language checks preserves the code without deprecation warnings\\\"\\\"\\\"\\n    with warnings.catch_warnings(record=True) as caught:\\n        warnings.simplefilter(\\\"always\\\")\\n        tts = gTTS(text=\\\"Hello world\\\", lang=lang, lang_check=False)\\n    assert tts.lang == lang\\n    assert not caught\\n\\n'''\\nassert anchor in source\\npath.write_text(source.replace(anchor, new + anchor, 1))\\nPY\\npython -m pytest gtts/tests/test_lang.py gtts/tests/test_tts.py::test_deprecated_language_check -x --tb=short\"}",
