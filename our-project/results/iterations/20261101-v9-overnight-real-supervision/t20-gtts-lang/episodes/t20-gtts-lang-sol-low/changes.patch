 # -*- coding: utf-8 -*-
+import warnings
 import pytest
 from gtts.lang import tts_langs, _extra_langs, _fallback_deprecated_lang
 from gtts.langs import _main_langs
@@ -13,10 +14,47 @@ def test_main_langs():
