 # -*- coding: utf-8 -*-
 import os
+import warnings
 import pytest
 from unittest.mock import Mock
 
@@ -64,6 +65,35 @@ def test_unsupported_language_check():
         gTTS(text=text, lang=lang, lang_check=check)
 
 
+@pytest.mark.parametrize(
+    "lang, fallback_lang",
+    [
+        ("en-gb", "en"),
+        ("fr-fr", "fr"),
+        ("pt-br", "pt"),
+        ("es-es", "es"),
+        ("es-us", "es"),
+        ("zh-cn", "zh-CN"),
+        ("zh-tw", "zh-TW"),
+    ],
+)
+def test_deprecated_language_check(lang, fallback_lang):
+    """Deprecated language codes fall back during gTTS initialization"""
+    with pytest.deprecated_call(match="falling back to '{}'".format(fallback_lang)):
+        tts = gTTS(text="Hello world", lang=lang)
+    assert tts.lang == fallback_lang
+
+
+@pytest.mark.parametrize("lang", ["en-gb", "es-es", "zh-cn", "zh-tw", "xx"])
+def test_language_check_disabled(lang):
+    """Disabling language checks preserves the code without deprecation warnings"""
+    with warnings.catch_warnings(record=True) as caught:
+        warnings.simplefilter("always")
+        tts = gTTS(text="Hello world", lang=lang, lang_check=False)
+    assert tts.lang == lang
+    assert not caught
+
+
