-        assert _fallback_deprecated_lang("en-gb") == "en"
+@pytest.mark.parametrize(
+    "lang, fallback_lang",
+    [
+        ("en-us", "en"),
+        ("en-ca", "en"),
+        ("en-uk", "en"),
+        ("en-gb", "en"),
+        ("en-au", "en"),
+        ("en-gh", "en"),
+        ("en-in", "en"),
+        ("en-ie", "en"),
+        ("en-nz", "en"),
+        ("en-ng", "en"),
+        ("en-ph", "en"),
+        ("en-za", "en"),
+        ("en-tz", "en"),
+        ("fr-fr", "fr"),
+        ("pt-br", "pt"),
+        ("pt-pt", "pt"),
+        ("es-es", "es"),
+        ("es-us", "es"),
+        ("zh-cn", "zh-CN"),
+        ("zh-tw", "zh-TW"),
+    ],
+)
+@pytest.mark.parametrize(
+    "case", [str.lower, str.upper, str.title], ids=["lowercase", "uppercase", "mixed-case"]
+)
+def test_deprecated_lang(lang, fallback_lang, case):
+    """Test language deprecation fallback regardless of case"""
+    with pytest.deprecated_call(match="falling back to '{}'".format(fallback_lang)):
+        assert _fallback_deprecated_lang(case(lang)) == fallback_lang
+
+
+@pytest.mark.parametrize("lang", ["en", "fr", "pt", "es", "zh", "xx", "EN", ""])
+def test_non_deprecated_lang(lang):
+    """Non-deprecated language tags are returned as-is without warnings"""
+    with warnings.catch_warnings(record=True) as caught:
+        warnings.simplefilter("always")
+        assert _fallback_deprecated_lang(lang) == lang
+    assert not caught
 
 
