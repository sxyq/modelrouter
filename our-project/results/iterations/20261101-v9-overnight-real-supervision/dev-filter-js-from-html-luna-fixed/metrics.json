              "function_name": "bash",
              "arguments": {
                "command": "cat > /app/filter.py <<'PY'\n#!/usr/bin/env python3\n\"\"\"Remove executable JavaScript from an HTML file in place.\"\"\"\nimport sys\nfrom html.parser import HTMLParser\nfrom pathlib import Path\n\n\nclass JavaScriptFilter(HTMLParser):\n    VOID_ELEMENTS = {\n        \"area\", \"base\", \"br\", \"col\", \"embed\", \"hr\", \"img\", \"input\",\n        \"link\", \"meta\", \"param\", \"source\", \"track\", \"wbr\",\n    }\n\n    def __init__(self):\n        super().__init__(convert_charrefs=False)\n        self.output = []\n        self.drop_script = 0\n        self.drop_textarea = 0\n\n    @staticmethod\n    def _js_url(value):\n        if value is None:\n            return False\n        # Ignore whitespace and control characters often used to obscure the scheme.\n        compact = \"\".join(ch for ch in value if ord(ch) > 32 and ord(ch) != 127)\n        return compact.lower().startswith(\"javascript:\")\n\n    def handle_starttag(self, tag, attrs):\n        tag_lower = tag.lower()\n        if self.drop_script:\n            if tag_lower == \"script\":\n                self.drop_script += 1\n            return\n        if self.drop_textarea:\n            if tag_lower == \"textarea\":\n                self.drop_textarea += 1\n            return\n        if tag_lower == \"script\":\n            self.drop_script = 1\n            return\n        kept = []\n        for name, value in attrs:\n            lname = name.lower()\n            if lname.startswith(\"on\") or self._js_url(value):\n                continue\n            kept.append((name, value))\n        self.output.append(\"<\" + tag)\n        for name, value in kept:\n            self.output.append(\" \" + name)\n            if value is not None:\n                escaped = value.replace(\"&\", \"&amp;\").replace('\"', \"&quot;\")\n                self.output.append('=\"' + escaped + '\"')\n        self.output.append(\">\")\n\n    def handle_startendtag(self, tag, attrs):\n        tag_lower = tag.lower()\n        if self.drop_script or self.drop_textarea or tag_lower == \"script\":\n            return\n        kept = [(n, v) for n, v in attrs\n                if not n.lower().startswith(\"on\") and not self._js_url(v)]\n        self.output.append(\"<\" + tag)\n        for name, value in kept:\n            self.output.append(\" \" + name)\n            if value is not None:\n                escaped = value.replace(\"&\", \"&amp;\").replace('\"', \"&quot;\")\n                self.output.append('=\"' + escaped + '\"')\n        self.output.append(\" />\")\n\n    def handle_endtag(self, tag):\n        tag_lower = tag.lower()\n        if self.drop_script:\n            if tag_lower == \"script\":\n                self.drop_script -= 1\n            return\n        if self.drop_textarea:\n            if tag_lower == \"textarea\":\n                self.drop_textarea -= 1\n            return\n        if tag_lower == \"textarea\":\n            self.output.append(\"</\" + tag + \">\")\n            return\n        self.output.append(\"</\" + tag + \">\")\n\n    def handle_data(self, data):\n        if not self.drop_script and not self.drop_textarea:\n            self.output.append(data)\n\n    def handle_entityref(self, name):\n        if not self.drop_script and not self.drop_textarea:\n            self.output.append(\"&\" + name + \";\")\n\n    def handle_charref(self, name):\n        if not self.drop_script and not self.drop_textarea:\n            self.output.append(\"&#\" + name + \";\")\n\n    def handle_comment(self, data):\n        if not self.drop_script and not self.drop_textarea:\n            self.output.append(\"<!--\" + data + \"-->\")\n\n    def handle_decl(self, decl):\n        if not self.drop_script and not self.drop_textarea:\n            self.output.append(\"<!\" + decl + \">\")\n\n    def handle_pi(self, data):\n        if not self.drop_script and not self.drop_textarea:\n            self.output.append(\"<?\" + data + \">\")\n\n\ndef main():\n    path = Path(sys.argv[1])\n    text = path.read_text(encoding=\"utf-8\")\n    parser = JavaScriptFilter()\n    parser.feed(text)\n    parser.close()\n    path.write_text(\"\".join(parser.output), encoding=\"utf-8\")\n\n\nif __name__ == \"__main__\":\n    main()\nPY\npython3 - <<'PY'\nimport pathlib, subprocess, tempfile\np=pathlib.Path('/tmp/filter-test.html')\np.write_text('<!doctype html><table onclick=\"x\"><tr><td>ok<script>alert(1)</script><a href=\"javascript:alert(1)\" title=\"x\">link</a><img src=\"x\" onerror=\"x\"></td></tr></table>')\nsubprocess.run(['python3','/app/filter.py',str(p)],check=True)\nprint(p.read_text())\nPY\n"
