        "arguments": "{\"command\":\"cat > /tmp/bookforum-test/numeric_probe.py <<'PY'\\nimport ctypes as c\\n\\nclass Attr(c.Structure):\\n    _fields_ = [('type',c.c_ushort),('digits',c.c_ushort),('scale',c.c_short),('flags',c.c_ushort),('pic',c.c_void_p)]\\nclass Field(c.Structure):\\n    _fields_ = [('size',c.c_size_t),('data',c.POINTER(c.c_ubyte)),('attr',c.POINTER(Attr))]\\nlib=c.CDLL('libcob.so.4')\\nlib.cob_init.argtypes=[c.c_int,c.c_void_p]\\nlib.cob_init(0,None)\\nfor fn in ('cob_move','cob_add','cob_sub'):\\n    getattr(lib,fn).argtypes = [c.POINTER(Field),c.POINTER(Field)] + ([] if fn=='cob_move' else [c.c_int])\\n\\ndef field(b,scale=0):\\n    a=Attr(0x10,len(b),scale,0,None)\\n    buf=(c.c_ubyte*len(b)).from_buffer_copy(b)\\n    f=Field(len(b),buf,c.pointer(a))\\n    return a,buf,f\\n\\ndef result(amount, balance=b'0000001000', verbose=True):\\n    a1,b1,f1=field(amount)\\n    a2,b2,f2=field(b'0'*12,2)\\n    a3,b3,f3=field(balance)\\n    a4,b4,f4=field(b'0'*10)\\n    a5,b5,f5=field(balance)\\n    lib.cob_move(c.byref(f1),c.byref(f2))\\n    lib.cob_move(c.byref(f2),c.byref(f4))\\n    lib.cob_sub(c.byref(f3),c.byref(f2),0)\\n    lib.cob_add(c.byref(f5),c.byref(f2),0)\\n    r=(bytes(b2),bytes(b4),bytes(b3),bytes(b5))\\n    if verbose: print(repr(amount), repr(balance), [repr(x) for x in r])\\n    return r\\n\\nif __name__=='__main__':\\n    for a in (b'0000000200',b'200'+b'\\\\0'*7,b' '*10,b'-000000200',b'00000200.5',b'abcdefghij',b'000000000a',b'a000000000',b'00000000-2',b'000000000:', b'000000000/', b'00000000\\\\x002',b'00000 0002',b'00000\\\\xff0002',b'\\\\xff'*10,b'\\\\0'*10):\\n        result(a)\\n    print('last byte digit decoding:')\\n    for ch in range(256):\\n        r=result(b'000000000'+bytes([ch]),balance=b'0000000000',verbose=False)\\n        if ch%16==0: print()\\n        print(f'{ch:02x}:{r[2].decode(\\\"ascii\\\")} ',end='')\\n    print()\\nPY\\npython3 /tmp/bookforum-test/numeric_probe.py\\nobjdump -d --start-address=0x22110 --stop-address=0x22510 /lib/x86_64-linux-gnu/libcob.so.4\"}",
