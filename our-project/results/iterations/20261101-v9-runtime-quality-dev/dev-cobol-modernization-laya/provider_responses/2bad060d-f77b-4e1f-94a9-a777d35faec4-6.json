        "arguments": "{\"command\":\"cat > /tmp/bookforum-reference/readprobe.cbl <<'COB'\\n       identification division.\\n       program-id. readprobe.\\n       environment division.\\n       input-output section.\\n       file-control.\\n           select f assign to 'src/INPUT.DAT'\\n               organization sequential\\n               file status fs.\\n       data division.\\n       file section.\\n       fd f.\\n       01 rec pic x(22).\\n       working-storage section.\\n       01 fs pic xx.\\n       01 n binary-long.\\n       01 v pic 999.\\n       01 eof pic x value 'N'.\\n       procedure division.\\n           display 'INITIAL'\\n           perform dump-rec\\n           open input f\\n           perform until eof = 'Y'\\n               read f\\n               display 'STATUS=' fs\\n               perform dump-rec\\n               if fs = '10' move 'Y' to eof end-if\\n           end-perform\\n           close f\\n           stop run.\\n       dump-rec.\\n           perform varying n from 1 by 1 until n > 22\\n               compute v = function ord(rec(n:1)) - 1\\n               display v ' ' with no advancing\\n           end-perform\\n           display ' '.\\nCOB\\ncobc -x -o /tmp/bookforum-reference/readprobe /tmp/bookforum-reference/readprobe.cbl\\ncd /tmp/bookforum-reference && mkdir -p dump/src && printf 'U001U002B001200' > dump/src/INPUT.DAT && cd dump && /tmp/bookforum-reference/readprobe\\ncd /tmp/bookforum-reference/dump && printf 'abcdefghijklmnopqrstuvHELLO' > src/INPUT.DAT && /tmp/bookforum-reference/readprobe\\nprintf '\\\\n--- partial ID/owner retention probes ---\\\\n'; PYTHONPATH=/tmp/bookforum-reference python - <<'PY'\\nfrom probe import *\\nrun('partial-input-null-ids', inp=b'U001', accounts=account(b'U001')+account(b'\\\\x00'*4), books=book(ident=b'\\\\x00'*4,owner=b'\\\\x00'*4))\\nrun('partial-book-null-owner', books=b'B001'+b'Title'.ljust(20,b' '), inp=b'U001'+b'\\\\x00'*4+b'B0010000000200', accounts=account(b'U001')+account(b'\\\\x00'*4))\\nrun('partial-book-owner-retained', books=book(ident=b'B002')+b'B001Title')\\nrun('partial-book-owner-not-retained', books=book(ident=b'B002',owner=b'U003')+b'B001Title')\\nrun('partial-account-id-retained', accounts=account(b'U001')+account(b'U002')+b'U', inp=b'U001U002B0010000000200')\\nrun('partial-account-after-nonmatch', accounts=account(b'U001')+account(b'U002')+account(b'U003')+b'U')\\nrun('partial-account-before-matches', accounts=b'X')\\nPY\\npython - <<'PY'\\nfor s in [b'abcdefghij00',b'-00000020000',b'+00000020000',b'0000001.5000',b'1000      ']:\\n    n=0\\n    for c in s.lstrip(b' \\\\x00'):\\n        n=(n*10+c-48)%2**64\\n    print(repr(s),n, 'buyer',abs(100000-n)//100%10**10,'seller',(200000+n)//100%10**10)\\nPY\"}",
