.DS_Store
.playwright-cli/
.env
.env.*
!.env.example
**/.git/
**/__pycache__/
**/*.pyc
# 克隆的第三方开源仓库（含各自 .git 历史，体积大且可重新 clone）
research/*/implementation/repos/

# 模型缓存与预训练权重（可重新下载）
**/.cache/
*.joblib
*.pkl

# 数据集（体积大，可按 README 指引重新获取）
research/*/data/
**/question_bank.jsonl
/data/

*.log

# ModelRouter 服务器本地权重、实验结果、隔离环境及临时文件（只在服务器保留）
/models/
/external/
/runs/
!/runs/agent_pilot/
/runs/agent_pilot/*
!/runs/agent_pilot/comparison.csv
!/runs/agent_pilot/real_matrix_summary.json
!/runs/agent_pilot/canary_report.json
/.tmp/
/.venv/
AGENTS.md

# API credentials are secrets and MUST NOT be committed
/experiments/agent_pilot/configs/generator_credentials.json
/experiments/agent_pilot/configs/*credentials*.json
!/experiments/agent_pilot/configs/generator_credentials.example.json
/experiments/agent_pilot/configs/*.key
/experiments/agent_pilot/configs/*.secret
