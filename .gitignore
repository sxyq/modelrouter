.DS_Store
.playwright-cli/
.env
.env.*
!.env.example
**/.git/
**/__pycache__/
**/*.pyc
# 克隆的第三方开源仓库（含各自 .git 历史，体积大且可重新 clone）
research/*/implementation/repos/

# 模型缓存与预训练权重（可重新下载）
**/.cache/
*.joblib
*.pkl

# 数据集（体积大，可按 README 指引重新获取）
research/*/data/
**/question_bank.jsonl
/data/

*.log

# ModelRouter 服务器本地权重、实验结果、隔离环境及临时文件（只在服务器保留）
/models/
/external/
/runs/
!/runs/agent_pilot/
/runs/agent_pilot/*
!/runs/agent_pilot/comparison.csv
!/runs/agent_pilot/real_matrix_summary.json
!/runs/agent_pilot/canary_report.json
/.tmp/
/.venv/
AGENTS.md

# Local API credentials and project runtime are NEVER committed; files stay on Mac/server.
/experiments/agent_pilot/configs/generator_credentials.json
/our-project/**/generator_credentials.json
/our-project/.runtime/
/our-project/code/.runtime/
/our-project/code/data/v9/prepared/
/.runtime/
/our-project/experiments/configs/benchmark_runtime.json
/our-project/dashboard/agent_benchmark_status.json
/our-project/code/src/runs/
/our-project/data/raw/
/our-project/data/interim/
/our-project/results/*
!/our-project/results/benchmark/
!/our-project/results/benchmarks/
/our-project/results/benchmark/trials/
/our-project/results/agent_trials/
/our-project/results/training/
/our-project/results/serving/
/our-project/external/**/upstream/
*.egg-info/

# P16/P17 本地私密配置（含内网服务地址）
汇报/汇报三/assets/local_config.json

# P16/P17 本地运行存档（每轮原始响应，仅本地保留）
汇报/汇报三/runs/

# ── 汇报三 · 第二个版本 ──────────────────────────────
# 本地私密配置（A6000 内网地址）与每轮原始响应存档，仅本机保留
汇报/汇报三 第二个版本/assets/local_config.json
汇报/汇报三 第二个版本/dist/assets/local_config.json
汇报/汇报三 第二个版本/runs/
# 图片/ 是 slides/ 的原始下载副本，内容重复，不入库
汇报/汇报三 第二个版本/图片/

# 离线压缩包可由 build 重新生成，不入库
汇报/汇报三 第二个版本/deck_bundle.zip
output/
our-project/dashboard/shards/training_history.json
